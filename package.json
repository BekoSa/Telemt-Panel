{
  "name": "telemt-control-panel",
  "version": "1.0.0",
  "description": "Web UI for Telemt Control API with session authentication",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "setup": "node setup-password.js init",
    "build": "esbuild src/client.jsx --bundle --minify --target=es2022 --format=iife --outfile=public/assets/app.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "memorystore": "^1.6.8"
  },
  "devDependencies": {
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
