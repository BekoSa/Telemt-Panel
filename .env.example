# ────────────────────────────────────────────────────
#  Telemt Control Panel — Environment Configuration
#  Copy to .env and fill in the values
# ────────────────────────────────────────────────────

# Panel login credentials
PANEL_USERNAME=admin

# Generate with: node setup-password.js hash <password>
PANEL_PASSWORD_HASH=$2a$12$...

# ─── OR for quick testing only (use hash in prod!) ───
# PANEL_PASSWORD=myplaintextpassword

# ────────────────────────────────────────────────────

# Telemt API address (server-side, never exposed to browser)
TELEMT_API_URL=http://127.0.0.1:9091

# Telemt API Authorization header value (if api.auth_header is set)
# TELEMT_API_TOKEN=your-telemt-token

# Note: the panel's /healthz endpoint checks panel-process liveness only.
# Telemt API availability/readiness is intentionally checked separately.

# Optional IP geolocation batch endpoint. Disabled by default so client IPs never
# leave the panel unless the operator explicitly configures a provider. External
# endpoints must use HTTPS; loopback HTTP is allowed for a local privacy proxy.
# Example for ip-api Pro (paid HTTPS endpoint):
# GEOIP_API_URL=https://pro.ip-api.com/batch
# GEOIP_API_KEY=your-provider-key

# ────────────────────────────────────────────────────

# Session secret — generate with: node setup-password.js secret
SESSION_SECRET=replace-with-random-96-hex-chars

# Session lifetime in hours (default 8, rolling)
SESSION_MAX_AGE_HOURS=8

# Panel listen port
PORT=3000

# ─── Production settings ─────────────────────────────
COOKIE_SECURE=false
# NODE_ENV=production

# Set to true when running behind nginx/caddy reverse proxy with HTTPS
TRUST_PROXY=false

# ─── Session security ─────────────────────────────────────────────────────────
# Idle timeout in minutes (0 = disabled)
SESSION_IDLE_MINUTES=60

# Bind session to the IP that logged in (blocks session hijacking, breaks if behind NAT)
BIND_SESSION_IP=false

# Audit log ring buffer size
AUDIT_LOG_MAX=1000
